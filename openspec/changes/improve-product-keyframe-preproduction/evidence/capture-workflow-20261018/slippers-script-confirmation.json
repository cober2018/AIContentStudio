    "capture_plan": {
      "schema": "video.capture-plan.v1",
      "route": "real",
      "script_structure": "面向为孩子挑选居家地板鞋的家长，一条约28秒短片用四个真实动作帮助判断：按压看可见形变→自然走动看本次跟脚表现→翻底看实际结构→棕灰两双同框看组合与装饰。先拍原片再按实际表现决定旁白，不预设实测结论。耐磨、材质、尺码及优惠尚无核验资料；不能作为已证实卖点。购买入口待提供，不编造。",
      "script_confirmation": {
        "source_master_revision_id": 50,
        "content_hash": "0c0dead833b7ddb4b17cc5f042a5c7d0e835a740ae6dae68c06ff0f916801502"
      }
    },
    "shots": [
      {
        "id": "capture-1",
        "order": 0,
        "label": "按压鞋面，看清触感表现",
        "duration_ms": 8000,
        "purpose": "让买家看见当次按压的实际形变，不凭画面推断材质成分或长期舒适性。",
        "framing": "close",
        "production": {
          "schema": "video.shot-production.v2",
          "source_mode": "existing"
        },
        "filming": {
          "scene_id": "同一居家自然光场景",
          "filming_order": 0,
          "raw_duration_ms": 12000,
          "action": "把鞋放在桌上，用手指轻压鞋面一次，松手后停留；不夸张拉扯。",
          "angle": "斜侧近景，手指与鞋面完整可见",
          "audio_note": "不要求现场旁白；可保留自然声音，后期再配音。",
          "camera_position": "手机离鞋约一臂距离，双手持稳，靠窗自然光",
          "evidence_requirement": "只描述本次看见的变化；柔软舒适的程度待实际素材评审。",
          "focus": "按压前、按压中、松手后的变化都看清",
          "subject": "家长手和一只棕色鞋"
        }
      },
      {
        "id": "capture-2",
        "order": 1,
        "label": "走两三步，看跟脚表现",
        "duration_ms": 7000,
        "purpose": "展示同一双鞋在本次合适尺码下的真实穿着状态，不许承诺所有孩子都跟脚。",
        "framing": "medium",
        "production": {
          "schema": "video.shot-production.v2",
          "source_mode": "existing"
        },
        "filming": {
          "scene_id": "同一居家自然光场景",
          "filming_order": 1,
          "raw_duration_ms": 12000,
          "action": "日常干燥地面上自然走两三步后停下，保持鞋子和脚后跟在画面中。",
          "angle": "侧后方中近景，不追拍、不快速转动",
          "audio_note": "不要求现场旁白；可保留自然声音，后期再配音。",
          "camera_position": "家长蹲低，手机固定，给走动留出画面空间",
          "evidence_requirement": "尺码未确认；先核对适合孩子再拍，不为了镜头要求跑跳。",
          "focus": "脚跟与鞋跟是否分离、走动是否自然",
          "subject": "孩子小腿以下和棕色鞋"
        }
      },
      {
        "id": "capture-3",
        "order": 2,
        "label": "翻到鞋底，看清实际结构",
        "duration_ms": 7000,
        "purpose": "补齐目前缺失的鞋底信息；实拍纹理不等于耐磨测试。",
        "framing": "close",
        "production": {
          "schema": "video.shot-production.v2",
          "source_mode": "existing"
        },
        "filming": {
          "scene_id": "同一居家自然光场景",
          "filming_order": 2,
          "raw_duration_ms": 12000,
          "action": "家长拿起鞋，慢慢转到鞋底朝镜头，停稳两秒。",
          "angle": "正对鞋底的近景",
          "audio_note": "不要求现场旁白；可保留自然声音，后期再配音。",
          "camera_position": "手机固定，鞋放画面中央，避免逆光",
          "evidence_requirement": "耐磨尚无测试或参数，不写耐磨承诺，也不做夸张摩擦演示。",
          "focus": "鞋底完整外形、纹路和边缘清晰",
          "subject": "一只灰色鞋的真实鞋底"
        }
      },
      {
        "id": "capture-4",
        "order": 3,
        "label": "棕灰同框，看装饰与组合",
        "duration_ms": 6000,
        "purpose": "让买家清楚一套是棕色一双加灰色一双，展示可爱装饰，不编造孩子评价。",
        "framing": "medium",
        "production": {
          "schema": "video.shot-production.v2",
          "source_mode": "existing"
        },
        "filming": {
          "scene_id": "同一居家自然光场景",
          "filming_order": 3,
          "raw_duration_ms": 12000,
          "action": "两双并排摆好，家长先指棕色装饰再指灰色装饰，最后手移开留完整同框。",
          "angle": "两双同框后轻微靠近装饰，动作一次完成",
          "audio_note": "不要求现场旁白；可保留自然声音，后期再配音。",
          "camera_position": "手机从前上方持稳，沿用同一背景和自然光",
          "evidence_requirement": "只展示实际商品；不加价格优惠、适用年龄或未核对尺寸。",
          "focus": "四只鞋、两色、真实装饰和轮廓一致",
          "subject": "棕色和灰色完整两双"
        }
      }
    ],
