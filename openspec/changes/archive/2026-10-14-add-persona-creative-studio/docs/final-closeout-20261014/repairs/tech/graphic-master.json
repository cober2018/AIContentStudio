            "runs": [
              {
                "text": "人设与账号为何分开",
                "style": {
                  "font_size": 60,
                  "color": "#f5f7fa",
                  "weight": 400,
                  "italic": false,
                  "align": "left"
                }
              }
            ],
            "claims": []
          },
          {
            "id": "cover-body",
            "order": 2,
            "type": "text",
            "x": 72,
            "y": 300.0,
            "width": 936,
            "height": 95.19999999999999,
            "rotation": 0,
            "opacity": 1,
            "visible": true,
            "locked": false,
            "runs": [
              {
                "text": "一个架构取舍：把表达原则留在人设层，让账号承担平台身份与分发规则。跨平台时复用创作内核，也要付出映射成本。",
                "style": {
                  "font_size": 34,
                  "color": "#f5f7fa",
                  "weight": 400,
                  "italic": false,
                  "align": "left"
                }
              }
            ],
            "claims": []
          }
        ],
        "role": "cover"
      },
      {
        "id": "body-1",
        "order": 1,
        "width": 1080,
        "height": 1440,
        "background": {
          "color": "#101827"
        },
        "layers": [
          {
