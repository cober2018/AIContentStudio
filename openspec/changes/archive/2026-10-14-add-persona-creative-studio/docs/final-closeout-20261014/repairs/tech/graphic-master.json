            "locked": false,
            "shape": "rectangle",
            "fill": "#60a5fa",
            "stroke_width": 0
          },
          {
            "id": "body-2-title",
            "order": 1,
            "type": "text",
            "x": 72,
            "y": 104,
            "width": 936,
            "height": 134.39999999999998,
            "rotation": 0,
            "opacity": 1,
            "visible": true,
            "locked": false,
            "runs": [
              {
                "text": "解耦也有成本",
                "style": {
                  "font_size": 48,
                  "color": "#f5f7fa",
                  "weight": 400,
                  "italic": false,
                  "align": "left"
                }
              }
            ],
            "claims": []
          },
          {
            "id": "body-2-body",
            "order": 2,
            "type": "text",
            "x": 72,
            "y": 266.4,
            "width": 936,
            "height": 285.59999999999997,
            "rotation": 0,
            "opacity": 1,
            "visible": true,
            "locked": false,
            "runs": [
              {
                "text": "独立的人设仍需要一套映射，把内容转为各平台接受的规格。前期复杂度和转换开销并不会消失。\n\n取舍的理由是核心表达更便于迁移：渠道变化时，可以单独调整适配，也保留决定如何表达的空间。",
                "style": {
                  "font_size": 34,
                  "color": "#f5f7fa",
                  "weight": 400,
                  "italic": false,
                  "align": "left"
                }
              }
            ],
            "claims": []
          }
