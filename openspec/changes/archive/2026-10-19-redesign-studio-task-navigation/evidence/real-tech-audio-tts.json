warnings": []}, "summary": "将知识问答评估与工程契约主稿转化为适合三分钟朗读的口语稿，明确区分外部个案背景与本稿工程建议。"}, "voice": {"accepted_hash": "d0ff7cb5e7efc4d9bb7035b65284b0e670fc4056a5dd71416674b6a5d237e879", "attempt_id": 132, "attempt_no": 1, "candidate_id": "voice-direction-0", "decision": "accepted", "entity_id": 132, "feedback_event_id": 291, "node_id": "voice", "output_hash": "3fed460062f926fe3ee2ba8da25d152fcc791569f10e0294f4ac944f457b7ef7", "output_kind": "creative_attempt", "output_schema": "audio.voice-direction.v1", "plugin": "stage.creative.method", "plugin_version": "1", "references": [], "run_id": 24, "schema": "stage.handoff.v1", "selected_content": {"energy": "沉稳克制，声压均衡，重在逻辑清晰而非情绪起伏", "pace": "medium", "pause_policy": "逗号处微顿约300毫秒，句号与逻辑递进处停顿约500至700毫秒；段落切换及假设推演分支之间保留约800至1000毫秒明确气口，确保听众清晰区分输入契约与推演场景。", "pronunciation_notes": ["“阈值”标准读音为 yù zhí，请勿误读为 fá zhí", "“分块”读作 fēn kuài，字音清晰，避免吞音", "“快照”读作 kuài zhào，平稳吐字", "“转译”读作 zhuǎn yì，重音落在“译”字上以突出动作含义"], "rate": 1.0, "voice_character": "冷静严谨的资深软件架构师与技术解说者，语调沉稳、克制且平实；不带营销腔调与夸张重音，以理性的工程讨论语气交代系统约束、边界与权衡取舍。"}, "summary": "为已审阅口语稿制定冷静克制、逻辑清晰的工程师解说音色指引与停顿策略。"}}, "workflow": {"checksum": "5d3937554338a7325449c7b36c6dbb4b0d26e7367c0904e911026875d4549dee", "id": 33, "version": 1}}, "expected_context_hash": "5bd7c517354842051f5ede2bba364a40f62176a56dc22f5d911fde9fb5a0aaf5", "expected_revision": 1, "is_current": true, "accepted_target": null, "accepted_master": null, "domain_output": {"domain": "media", "live": {"candidate_count": 1, "candidate_mode": "single", "candidates": [], "capability": "tts", "content_hash": "52f593b32369294afac13615953dd1101b0c9c71364a63577805c287470f512b", "created_at": "2026-10-19T07:08:43.332366", "execution_profile": "minimax.speech", "frozen_parameters": {"items": 1, "rate": 1.0, "seconds": 360, "timeout_seconds": 25, "voice_id": "lengdan_xiongzhang"}, "has_original_job": false, "material_revision_id": null, "mime_type": "audio/wav", "model_id": "speech-2.8-hd", "multimedia_config_hash": "b504c662c8b0d04923ab6f763cab6d9cb8