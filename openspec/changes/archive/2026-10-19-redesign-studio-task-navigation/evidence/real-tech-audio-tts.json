": {}, "revision_id": 2, "source_kind": "capability_memory"}]}, "review": {"enabled": true, "methods": [{"artifact_id": 12, "enabled": true, "id": "delivery-review", "parameters": {}, "revision_id": 24, "source_kind": "capability_memory"}]}, "script": {"enabled": false, "methods": [{"artifact_id": 2, "enabled": true, "id": "grounded-writing", "parameters": {}, "revision_id": 4, "source_kind": "capability_memory"}, {"artifact_id": 3, "enabled": true, "id": "concept-explanation", "parameters": {}, "revision_id": 6, "source_kind": "capability_memory"}, {"artifact_id": 4, "enabled": true, "id": "chinese-polish", "parameters": {}, "revision_id": 8, "source_kind": "capability_memory"}]}, "sound_edit": {"enabled": true, "methods": [{"artifact_id": 7, "enabled": true, "id": "dialogue-semantic-cut", "parameters": {}, "revision_id": 14, "source_kind": "capability_memory"}]}, "voice": {"enabled": true, "methods": [{"artifact_id": 5, "enabled": true, "id": "narration-alignment", "parameters": {}, "revision_id": 10, "source_kind": "capability_memory"}]}}, "provenance": {"blueprint_key": "starter.ai-tech-engineer.v1", "blueprint_version": "1", "default_recipe_key": "persona.audio.ai-tech.v1"}, "quality_profile_ref": "studio.quality.audio.explainer@1", "schema": "persona.creative.audio.v1", "skill_ref": "studio.audio.tts@1", "stage_instruction": null, "style_preset_ref": "studio.audio.calm-engineer@1"}, "content_boundaries": ["不夸大能力", "明确限制和 trade-off", "事实与推测分开"], "content_domains": ["AI Agent", "软件架构", "开发工具", "工程实践"], "expression_style": {"evidence": "required", "hype": "low", "reference_style": {"artifact_id": 13, "content_hash": "e59b00f334ba8e2940e037ebff9771ddf7ca2f23aaadd05558c444d577c622d6", "content_schema": "persona.reference-style.v1", "observations": [{"certainty": "direct", "locator": "标题、首段与「表达逻辑与分发通道的边界」段落", "modality": "text", "reference": {"content_hash": "8d587ec84249c9542eefa459c52ee635b2d3190ab256a88eadac02368338696a", "id": 25, "kind": "source"}, "statement": "文章先提出人设绑定平台账号的常见直觉与维护问题，再分节解释表达逻辑和分发通道的边界。"}, {"certainty": "direct", "locator": "「架构抽象的代价与取舍」两段", "modality": "text", "reference": {"content_hash": "8d587ec84249c9542eefa459c52ee635b2d3190ab256a88eadac02368338696a", "id": 25, "kind": "source"}, "statement": "文章明确讨论解耦的设计复杂度和转换开销，并解释换来的便携性；没有把参考作者个人经历写作论据。"}, {"certainty": "direct", "locator": "1080×1440整页；左上标题区、顶部短横线、正文区", "modality": "image", "reference": {"content_hash": "114cecba9142629d899fd673d3a3baa515adcb870346bc52ccf3d0a565430d68", "id": 19, "kind": "material_revision"}, "statement": "卡片使用深色整页底、白色大字标题与正文，左上有一条薄荷绿色短横线；大面积留白。"}, {"certainty": "direct", "locator": "graphic-2.png标题和正文；同系列graphic-3.png作为已导入对照", "modality": "image", "reference": {"content_hash": "2997a4067304558838a0374c0b9ce9e62f47a425611b4fe32bfd231d9c7246ed", "id": 20, "kind": "material_revision"}, "statement": "第二张用标题和正文区分逻辑内核与通道边界，第三张延续同版式说明工程取舍；图片为文字卡，并非关系图。"}, {"certainty": "inferred", "locator": "graphic-3.png整页配色与标题层级", "modality": "image", "reference": {"content_hash": "2f5ab95b71e16d253c42612a2e2e29271e2fa6a13be5e85e1bb43ff7edc48455", "id": 21, "kind": "material_revision"}, "statement": "深蓝、白、薄荷绿可作为科技角色试用配色，来自这组三卡的局部样本；尚未证明适合所有主题，不定为永久规则。"}, {"certainty": "direct", "locator": "原参考视频00:01:00.000静帧；左中录屏、右侧用途卡/出镜、底部字幕", "modality": "video", "reference": {"content_hash": "291b0271d12b3b56f33c4b5057edbcf57139516f50b4cf7fd42b3fa801090738", "id": 22, "kind": "material_revision"}, "statement": "60秒静帧以软件录屏为主体，右侧出现用途说明卡和出镜者，底部是中英字幕；该帧只能支持画面布局观察，不能推定镜头节奏。"}, {"certainty": "inferred", "locator": "00:01:00.000右上用途卡与主体录屏；仅据静帧提出试用方向", "modality": "video", "reference": {"content_hash": "291b0271d12b3b56f33c4b5057edbcf57139516f50b4cf7fd42b3fa801090738", "id": 22, "kind": "material_revision"}, "statement": "试用作品可优先使用真实操作录屏和解释关系的图示，选择性强调关键字或数字；关系图和选择性强调是经用户采纳的迁移方向，不声称原参考每段都使用。"}, {"certainty": "unknown", "locator": "00:01:00.000静帧无音轨；全片声音未直接试听", "modality": "video", "reference": {"content_hash": "291b0271d12b3b56f33c4b5057edbcf57139516f50b4cf7fd42b3fa801090738", "id": 22, "kind": "material_revision"}, "statement": "此轮未直接试听原片，不能判断BGM类型、混音、声纹或全片语气。"}], "revision_id": 26, "text": "科技角色首版风格（用户已采纳2026-10-16的47秒完整样片为首版默认；后续作品继续独立评审）\n1. 以读者问题或可观察结果开头，解释机制、适用边界与成本。\n2. 用具体平实的技术表达，不借用参考作者身份、经历或旧结论。\n3. 优先真实操作画面与关系图，仅选择性强调关键词和数字；本次实际以原创AE图示验证。\n4. 深蓝、白、薄荷绿作为首版视觉方向。\n5. 沿用现有科技角色音色lengdan_xiongzhang/rate=1与既有Recipe、知识来源；配乐按场景选择，允许无BGM。\n写作方法默认关闭：三组对照文案均需修订，完整片采用关闭组修订稿，不能据此宣称写作组合胜出。其他阶段使用已实际验证的方法。\n用户采纳作品不代表直接试听完成；原参考片仅观察单帧，音频未直接试听，ASR对齐仍是估计。"}, "tradeoffs": "explicit", "voice": "engineering_first"}, "graphic_creative_profile": {"capability": "image_generation", "capability_memory_revision_ids": [26], "installed_skill_refs": [], "mode": "auto", "model_binding": null, "model_chain": [], "parameters": {}, "production_stages": {"research": {"enabled": true, "methods": [{"artifact_id": 1, "enabled": true, "id": "research-evidence", "parameters": {}, "revision_id": 2, "source_kind": "capability_memory"}]}, "review": {"enabled": true, "methods": [{"artifact_id": 12, "enabled": true, "id": "delivery-review", "parameters": {}, "revision_id": 24, "source_kind": "capability_memory"}]}, "script": {"enabled": false, "methods": [{"artifact_id": 2, "enabled": true, "id": "grounded-writing", "parameters": {}, "revision_id": 4, "source_kind": "capability_memory"}, {"artifact_id": 3, "enabled": true, "id": "concept-explanation", "parameters": {}, "revision_id": 6, "source_kind": "capability_memory"}, {"artifact_id": 4, "enabled": true, "id": "chinese-polish", "parameters": {}, "revision_id": 8, "source_kind": "capability_memory"}]}, "storyboard": {"enabled": true, "methods": [{"artifact_id": 6, "enabled": true, "id": "visual-shot-plan", "parameters": {}, "revision_id": 12, "source_kind": "capability_memory"}]}}, "provenance": {"blueprint_key": "starter.ai-tech-engineer.v1", "blueprint_version": "1", "default_recipe_key": "persona.graphic.ai-tech.v1"}, "quality_profile_ref": "studio.quality.graphic.editorial@1", "schema": "persona.creative.gra