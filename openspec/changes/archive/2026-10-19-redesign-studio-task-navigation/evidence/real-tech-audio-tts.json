omatic", "resolution_hash": "9aec45a66e21fc8dba7ffc31da92b47c35a8865362949ec1a27c7ca3a8e416bd", "runtime_identity_hash": "8371611390f4953f1f0914cdd50d8308bb851c79792c7bf57b9c756758c76e3a", "schema": "creation_recipe.execution_receipt.v1", "stage_contract_hash": "8532825e98a4e4eefff2c0b83af32c6f715bfb662362f80e8dedc1af76c27754", "upstream_hash": "c36ede87816693bf7838bd5f7b6f00cc0ad0b0f059caa79c6e48d8d7a7604832", "workflow_id": 33, "workflow_run_id": 24}, "resolved_stage": {"base_config": {"capability": "tts", "items": 1, "method": {"skill_ref": "studio.audio.tts@1", "source_kind": "studio_builtin"}, "rate": 1, "seconds": 360, "selected_profile": "minimax.speech", "timeout_seconds": 25, "tts_source": "accepted_spoken", "voice": "lengdan_xiongzhang"}, "base_config_hash": "a15c01b5a0bbec209bea55e439fa3b52915e9343fd699e5356827b03031651db", "blockers": [], "config_hash": "a15c01b5a0bbec209bea55e439fa3b52915e9343fd699e5356827b03031651db", "context": {"asset_refs": [], "audio_stage": {"config_hash": "8e62d535b882d63086a92f245460bec7fce87cc2ff1ede0854828267b30372c2", "input_hash": "719e99165efe3894c7930025e4fff76610e0ce4a6e2c8256debf53560cf1cf4e", "node_id": "tts", "parameters": {"rate": 1.0, "voice_id": "lengdan_xiongzhang"}, "project_id": 35, "rate_difference": {"config_rate": 1.0, "differs": false, "direction_rate": 1.0, "source": "config"}, "run_id": 24, "schema": "studio.audio.stage.tts.v1", "script": "一个知识问答演示能够答对预设题目，并不等于它已经适合交付日常使用。在进入生产环境之前，系统真正需要补齐的不是更高的评测跑分，而是一整套明确的工程契约。需要先说明的是，外部作者的个案复盘仅代表其特定背景，相关的行业统计如果未经独立核验，不能直接作为通用结论引用。本文提出的三类评估与设计建议，属于软件工程视角的实践建议，并非特定业务的效果保证。工程落地的首要任务，就是把对模型能力的模糊期待，转译为确定性的系统约束。\n\n首先是契约化拆解。第一，定义输入边界。系统必须对原始文本做严格前置校验，按照模型上限预留输出空间，明确超限时是拒绝、分块还是截断，并通过规则过滤低效噪声。第二，规范预期输出。尽量避免非结构化的散漫文本，优先采用强契约的格式化输出，对关键字段设定必填检查与响应耗时基线。第三，明确判定规则。能确定检查的格式交给规则，语义判断则对照预先标注的要点；模型自报的置信度或回答一致性，都不能直接当作事实正确率，最终请求要分流至放行、降级或转人工。\n\n为了展示工程约束的运作方式，我们以一个明确标注为假设的知识问答系统进行推演。在标准正常流程下，资料充足且一致，模型依据检索内容提炼并携带引用源，校验通过后直接返回。在资料缺失场景下，检索得分低于安全阈值时，系统严禁模型自由发挥产生幻觉，而是触发快速失败分支，直接返回预设提示，跳过深度推理以节省成本和耗时。在资料冲突场景下，检索命中相互矛盾的规定时，不能仅凭发布日期新旧自行裁决，必须核对适用范围与来源；在无法确认时保守提示冲突，并路由至人工核查。\n\n不能假设模型每次都会遵守规则，系统必须建立防御性降级与转人工兜底。在证据不足、涉及关键业务决定，或者用户多轮无法解决时，按约定边界切入人工，并完整传递会话快照与结构化摘要。人工介入必然会带来排队延迟与人力成本，参数阈值需要在真实样本中反复校准。\n\n技术负责人在上线前不必先造庞大的评测平台。先拿一组真实、可脱敏的问题，逐条写清依据、允许的失败方式与责任人，持续重跑并记录变好与变差的分布。用确定性的工程防线，守住不可预测的模型输出。", "script_hash": "e645b65b759bdaa60b2135b1f965939c250f36052d4c6224d29efb390904438e", "spoken": {"attempt_id": 131, "attempt_input_hash": "ce1fd495eea4132d0a73803fdaaa8d332ca699f0526e2f60d3821669f2828768", "attempt_output_hash": "ba1884735c44c2e87fff7ffcd4698f7f05247ff6abb335b11a6ae220963e8dab", "config_hash": "223256585c2d8f96192532b131d064714edc151285a39c8e54fe869391f95c6b", "content_hash": "e815f99cbdb55f241a55ed3248e3de777b34000b41287ba80691579ebc69e24a", "target": {"accepted_hash": "e761fc9d88b47079b34494e9a6a2aa691463b3cb415312ddcacc4e63b8e1863a", "attempt_id": 131, "attempt_no": 2, "candidate_id": "spoken-adaptation-0", "decision": "accepted", "entity_id": 131, "feedback_event_id": 290, "node_id": "spoken", "output_hash": "ba1884735c44c2e87fff7ffcd4698f7f05247ff6abb335b11a6ae220963e8dab", "output_kind": "creative_attempt", "output_schema": "audio.spoken-adaptation.v1", "plugin": "stage.creative.method", "plugin_version": "1", "references": [], "run_id": 24, "schema": "stage.handoff.v1", "summary": "将知识问答评估与工程契约主稿转化为适合三分钟朗读的口语稿，明确区分外部个案背景与本稿工程建议。"}}, "tts_source": "accepted_spoken", "unit_id": 44, "voice_direction": {"attempt_id": 132, "attempt_input_hash": "bbde2f8840ec06d66156f372119fd5332fafa42584fcc39808d9bf5297a924dc", "attempt_output_hash": "3fed460062f926fe3ee2ba8da25d152fcc791569f10e0294f4ac944f457b7ef7", "config_hash": "5bde3c9953fbdb3f695de405ddefcac6c1e3427dbc35e7f6c30670445534b611", "content": {"energy": "沉稳克制，声压均衡，重在逻辑清晰而非情绪起伏", "pace": "medium", "pause_policy": "逗号处微顿约300毫秒，句号与逻辑递进处停顿约500至700毫秒；段落切换及假设推演分支之间保留约800至1000毫秒明确气口，确保听众清晰区分输入契约与推演场景。", "pronunciation_notes": ["“阈值”标准读音为 yù zhí，请勿误读为 fá zhí", "“分块”读作 fēn kuài，字音清晰，避免吞音", "“快照”读作 kuài zhào，平稳吐