# AI Content Studio 环境变量示例（复制为 .env 使用）
# Secret 只允许出现在环境变量/secret manager，禁止入库

# 数据库：默认 SQLite 便于本地零依赖启动；生产用 PostgreSQL
# DATABASE_URL=postgresql+psycopg://studio:studio@localhost:5432/content_studio
DATABASE_URL=sqlite:///./content_studio.db

# LLM Provider：mock | openai_compatible
LLM_PROVIDER=mock
# openai_compatible 模式下的配置（兼容 minimax / openai / 任意 OpenAI 风格网关）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Mock provider 测试开关：注入一个 FactPack 外数字，用于验证 FactCheck blocker 链路
MOCK_INJECT_UNFACT_NUMBER=false

# URL Import 安全限制
URL_FETCH_TIMEOUT_SECONDS=10
URL_FETCH_MAX_BYTES=5242880
# 仅本机开发用：本机代理为 fake-ip 模式（Clash 等）时置 true，否则外网抓取会被 SSRF 防护拦截。
# 生产环境必须保持 false。
SSRF_ALLOW_PRIVATE=false
