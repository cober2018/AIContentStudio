# Future deployment reference only. Do not copy real secrets into this file.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://<user>:<password>@<db-host>:5432/<database>
REQUIRED_SCHEMA_HEAD=<single-approved-alembic-head>

# Production auth is not enabled by the local profile.
AUTH_MODE=jwt_hs256
AUTH_ISSUER=https://<approved-issuer>
AUTH_AUDIENCE=<approved-audience>
AUTH_HMAC_SECRET=<secret-provider-reference>

MATERIAL_STORAGE_BACKEND=minio
MINIO_ENABLED=true
MINIO_ENDPOINT=<approved-storage-endpoint>
MINIO_BUCKET=<approved-bucket>
MINIO_ACCESS_KEY=<secret-provider-reference>
MINIO_SECRET_KEY=<secret-provider-reference>

TASK_QUEUE_ENABLED=true
CELERY_BROKER_URL=redis://<broker-host>:6379/0
SSRF_ALLOW_PRIVATE=false
# Optional exact-host CSV; empty preserves each capability's existing policy.
# Does not govern network calls made internally by the MiniMax CLI.
OUTBOUND_ALLOWED_HOSTS=

# External provider credentials must use the deployment secret provider.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://<approved-provider>/v1
LLM_API_KEY=<secret-provider-reference>
LLM_MODEL=<approved-model>
