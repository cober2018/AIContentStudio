{
  "schema": "aics.ae-template.v1",
  "id": "map-route",
  "version": "v1",
  "name": "地图路线",
  "use": "在地图上从起点到终点画一条弧线，标出两端地名。起终点位置用图片上的相对坐标（0–1）。",
  "fields": [
    {
      "name": "title",
      "kind": "text",
      "max": 16,
      "required": true
    },
    {
      "name": "from",
      "kind": "text",
      "max": 10,
      "required": true
    },
    {
      "name": "to",
      "kind": "text",
      "max": 10,
      "required": true
    },
    {
      "name": "from_x",
      "kind": "number",
      "min": 0,
      "max": 1,
      "required": true
    },
    {
      "name": "from_y",
      "kind": "number",
      "min": 0,
      "max": 1,
      "required": true
    },
    {
      "name": "to_x",
      "kind": "number",
      "min": 0,
      "max": 1,
      "required": true
    },
    {
      "name": "to_y",
      "kind": "number",
      "min": 0,
      "max": 1,
      "required": true
    }
  ],
  "images": [
    {
      "name": "map",
      "file": "map.png",
      "required": false,
      "source": "real_only"
    }
  ],
  "duration_ms": {
    "min": 2000,
    "max": 10000,
    "default": 4000
  },
  "aspect_ratios": [
    "9:16"
  ],
  "size": [
    1080,
    1920
  ],
  "fps": 30,
  "fonts": [
    "PingFangSC-Semibold",
    "PingFangSC-Regular"
  ],
