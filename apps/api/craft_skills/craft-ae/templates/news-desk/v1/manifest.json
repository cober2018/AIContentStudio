{
  "schema": "aics.ae-template.v1",
  "id": "news-desk",
  "version": "v1",
  "name": "新闻卡片划重点",
  "category": "素材与地图",
  "use": "浅灰底整屏：第一张截图像纸一样微斜着从下方滑上来并缓慢推近，红线扫过关键句（line_x、line_y 是线起点在图里的相对位置，line_w 是相对长度，0 表示不划）；可选第二张截图从右侧压叠上来；右下角标来源。截图只用真实来源内容。",
  "fields": [
    {
      "name": "line_x",
      "kind": "number",
      "min": 0,
      "max": 1,
      "required": false
    },
    {
      "name": "line_y",
      "kind": "number",
      "min": 0,
      "max": 1,
      "required": false
    },
    {
      "name": "line_w",
      "kind": "number",
      "min": 0,
      "max": 1,
      "required": false
    },
    {
      "name": "source",
      "kind": "text",
      "max": 24,
      "required": false
    }
  ],
  "images": [
    {
      "name": "image1",
      "file": "image1.png",
      "required": true,
      "source": "any"
    },
    {
      "name": "image2",
      "file": "image2.png",
      "required": false,
      "source": "any"
    }
  ],
  "duration_ms": {
    "min": 4000,
    "max": 8000,
    "default": 5000
  },
  "aspect_ratios": [
    "9:16",
    "16:9"
