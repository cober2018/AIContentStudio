{
  "schema": "aics.ae-template.v1",
  "id": "magnifier",
  "version": "v1",
  "name": "局部放大镜",
  "category": "标注与聚焦",
  "use": "浅灰底上图片做成卡片，把一小块放大约 1.8 倍放到旁边圆形放大镜里，原处红框标出并用细线连接。x、y 是放大中心，r 是放大区半径（相对图片宽度）。",
  "fields": [
    {
      "name": "x",
      "kind": "number",
      "min": 0,
      "max": 1,
      "required": true
    },
    {
      "name": "y",
      "kind": "number",
      "min": 0,
      "max": 1,
      "required": true
    },
    {
      "name": "r",
      "kind": "number",
      "min": 0.04,
      "max": 0.25,
      "required": false
    }
  ],
  "images": [
    {
      "name": "image",
      "file": "image.png",
      "required": true,
      "source": "any"
    }
  ],
  "duration_ms": {
    "min": 3000,
    "max": 10000,
    "default": 5000
  },
  "aspect_ratios": [
    "9:16",
    "16:9"
  ],
  "size": [
    1080,
    1920
  ],
  "fps": 30,
  "fonts": [
    "SourceHanSansSC-Heavy"
  ],
