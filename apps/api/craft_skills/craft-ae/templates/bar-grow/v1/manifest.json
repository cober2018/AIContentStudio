      "kind": "text",
      "max": 16,
      "required": true
    },
    {
      "name": "labels",
      "kind": "text",
      "max": 80,
      "required": true
    },
    {
      "name": "values",
      "kind": "text",
      "max": 80,
      "required": true
    },
    {
      "name": "highlight",
      "kind": "number",
      "min": 1,
      "max": 8,
      "required": false
    },
    {
      "name": "conclusion",
      "kind": "text",
      "max": 16,
      "required": false
    },
    {
      "name": "source",
      "kind": "text",
      "max": 24,
      "required": false
    }
  ],
