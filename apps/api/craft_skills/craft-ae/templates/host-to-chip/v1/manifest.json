{
  "schema": "aics.ae-template.v1",
  "id": "host-to-chip",
  "version": "v1",
  "name": "讲者缩位让台",
  "category": "人物与图形",
  "use": "人物画面从全屏缩进左下角白边圆形头像，图形卡片从右侧滑入，头像旁可带一句特粗说明。圆框会自动把整张脸连脖子装进去并留出余量：face_x、face_y 填人物图里「头顶到脖子底」这一段的中心位置（0–1），face_size 填这一段占图片高度的比例（0–1），chip_size 是圆框直径（像素，默认 300）。人物用静帧图；叠真人视频请在达芬奇里合成。",
  "fields": [
    {
      "name": "caption",
      "kind": "text",
      "max": 16,
      "required": false
    },
    {
      "name": "face_x",
      "kind": "number",
      "min": 0,
      "max": 1,
      "required": false
    },
    {
      "name": "face_y",
      "kind": "number",
      "min": 0,
      "max": 1,
      "required": false
    },
    {
      "name": "face_size",
      "kind": "number",
      "min": 0.1,
      "max": 1,
      "required": false
    },
    {
      "name": "chip_size",
      "kind": "number",
      "min": 200,
      "max": 420,
      "required": false
    }
  ],
  "images": [
    {
      "name": "host",
      "file": "host.png",
      "required": true,
      "source": "any"
    },
    {
      "name": "graphic",
      "file": "graphic.png",
      "required": true,
      "source": "any"
    }
  ],
  "duration_ms": {
    "min": 3000,
    "max": 10000,
    "default": 5000
  },
  "aspect_ratios": [
    "9:16",
    "16:9"
  ],
  "size": [
    1080,
    1920
  ],
  "fps": 30,
  "fonts": [
    "SourceHanSansSC-Heavy"
  ],
